<aura:component>
    <aura:handler name="init" value="{!this}" action="{!c.onInit}"/>

    <aura:registerEvent name="xDOVideoCallComponentEvent" type="c:xDOVideoCallComponentEvent"/>

    <aura:attribute name="videoPanelSizeValues" type="Object[]"/>
    <aura:attribute name="microphoneValues" type="Object[]"/>
    <aura:attribute name="speakerValues" type="Object[]"/>
    <aura:attribute name="cameraValues" type="Object[]"/>

    <div class="slds-text-title slds-text-align_center slds-m-top_small slds-p-bottom_small title">Video Call Settings</div>
    <div class="slds-text-body_small slds-m-top_x-small slds-m-left_large slds-m-right_large">
        You can adjust these settings while on the video call by clicking on the gear icon in the video toolbar.
    </div>
    <div class="slds-grid slds-gutters slds-m-top_medium slds-m-left_xx-small slds-m-right_xx-small">
        <div class="slds-col slds-size_1-of-2">
            <div>
                <c:xdoSelect
                    picklistName="videoPanelSize"
                    picklistLabel="Video Panel Size"
                    picklistValues="{!v.videoPanelSizeValues}"
                    helpText="Help text">
                </c:xdoSelect>
            </div>
            <div class="slds-m-top_xx-small">
                <c:xdoSelect
                    picklistName="microphone"
                    picklistLabel="Microphone"
                    picklistValues="{!v.microphoneValues}">
                </c:xdoSelect>
            </div>
            <div class="slds-m-top_xx-small">
                <c:xdoSelect
                    picklistName="speaker"
                    picklistLabel="Speaker"
                    picklistValues="{!v.speakerValues}">
                </c:xdoSelect>
            </div>
            <div class="slds-m-top_xx-small">
                <c:xdoSelect
                    picklistName="camera"
                    picklistLabel="Camera"
                    picklistValues="{!v.cameraValues}">
                </c:xdoSelect>
            </div>
        </div>
        <div class="slds-col slds-size_1-of-2 relativePosition">
            <c:xdoWebcamStream showYouText="true" showMicLogo="true"/>
        </div>
    </div>

    <div class="slds-form-element slds-m-top_small slds-m-left_large slds-p-bottom_small title">
        <div class="slds-form-element__control">
            <div class="slds-checkbox">
                <input type="checkbox" name="options" id="rememberVideoSettings" value="rememberVideoSettings" checked=""/>
                    <label class="slds-checkbox__label" for="rememberVideoSettings">
                    <span class="slds-checkbox_faux"></span>
                    <span class="slds-form-element__label">
                        Remember these settings and set them as default for all video calls.
                    </span>
                </label>
            </div>
        </div>
    </div>

    <lightning:layout horizontalAlign="spread" class="slds-m-top_small">
        <lightning:layoutItem>
            <lightning:button label="Cancel" title="Cancel" onclick="{!c.cancelCall}" class="slds-m-left_medium"></lightning:button>
        </lightning:layoutItem>
        <lightning:layoutItem>
            <lightning:button label="Start Video Call" title="Start Video Call" variant="brand" onclick="{!c.startCall}" class="slds-m-right_medium"></lightning:button>
        </lightning:layoutItem>
    </lightning:layout>
</aura:component>