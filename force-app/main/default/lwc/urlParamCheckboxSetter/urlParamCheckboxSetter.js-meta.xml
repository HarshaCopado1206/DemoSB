<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata" fqn="urlParamCheckboxSetter">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>URL Checkboxer</masterLabel>
	<description>This is a hidden component that accepts paramaters from a URL to check or uncheck a checkbox field. Any field can be used and set to true or false. Created by Larry Davis</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Small"/>
                <supportedFormFactor type="Large"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>